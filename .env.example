# ── Identity ──────────────────────────────────────────────────
BOT_NAME=APEX-MD
BOT_PREFIX=.
OWNER_NAME=Owner
OWNER_NUMBER=2348012345678   # your number, no +

# ── Mode ──────────────────────────────────────────────────────
PUBLIC_MODE=false
AUTO_READ=true
AUTO_TYPING=true

# ── AI Keys (at least one required) ──────────────────────────
OPENAI_API_KEY=sk-...          # platform.openai.com
CLAUDE_API_KEY=sk-ant-...      # console.anthropic.com
GEMINI_API_KEY=AIza...         # aistudio.google.com (free)
ELEVENLABS_API_KEY=            # elevenlabs.io
STABILITY_API_KEY=             # stability.ai
PERPLEXITY_API_KEY=            # perplexity.ai

# ── Database (REQUIRED for API bridge) ───────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/apexmd
# Same URI must be set in apex-md-api on Render

# ── API bridge ────────────────────────────────────────────────
# URL of your apex-md-api Render deployment
# Bot pings this every 14 min to keep Render free tier awake
API_URL=https://your-apex-api.onrender.com

# ── Session ───────────────────────────────────────────────────
# Paste output of `node generate-session.js` here after QR scan
SESSION_ID=

# ── Misc keys ─────────────────────────────────────────────────
TENOR_API_KEY=       # tenor.com/developer — anime GIFs
WEATHER_API_KEY=     # openweathermap.org
NEWS_API_KEY=        # newsapi.org
AUDD_API_KEY=        # audd.io — shazam
URLSCAN_API_KEY=     # urlscan.io — virus scan
